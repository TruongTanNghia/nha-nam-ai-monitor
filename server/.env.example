# ================= MÁY CHỦ AI NHÀ NẤM — CẤU HÌNH =================
# Sao chép file này thành .env rồi điền thông tin.

# ---------- Firebase ----------
FIREBASE_DB_URL=https://nha-kinh-84aa2-default-rtdb.asia-southeast1.firebasedatabase.app
# FIREBASE_AUTH=            # database secret nếu rules yêu cầu đăng nhập
POLL_INTERVAL_SEC=5

# ---------- Web ----------
HOST=0.0.0.0                # 0.0.0.0 = điện thoại cùng WiFi truy cập được
PORT=5000
# Link từ xa Cloudflare (CHAY_NHA_NAM.bat tự bật)
TUNNEL_ENABLED=false
APP_USER=admin
# Mật khẩu web (tùy chọn). Để trống = không cần đăng nhập; đặt nếu không muốn ai có link cũng vào được
APP_PASSWORD=

# ---------- Zalo Bot (https://bot.zapps.me) ----------
ZALO_BOT_TOKEN=
# Nhiều người nhận: ngăn cách bằng dấu phẩy. Nhắn "chatid" cho bot để biết ID của bạn.
ZALO_CHAT_IDS=
ZALO_API_BASE=https://bot-api.zaloplatforms.com
ZALO_COMMANDS_ENABLED=true  # nhận lệnh điều khiển từ Zalo
ZALO_MAX_PER_HOUR=30       # tự giới hạn số tin để bot không bị Zalo khóa (vượt hạn mức)
ZALO_MAX_PER_DAY=300
ZALO_PAUSE_MIN=120         # Zalo báo vượt hạn mức -> ngừng gửi N phút

# ---------- LLM (để trống = dùng tin nhắn mẫu, không AI) ----------
# LLM_PROVIDER: anthropic | openai   (openai = mọi API tương thích OpenAI)
#   Claude:  LLM_PROVIDER=anthropic, LLM_API_KEY=sk-ant-...   (model mặc định claude-opus-5-5)
#   OpenAI:  LLM_PROVIDER=openai,    LLM_API_KEY=sk-...       (model mặc định gpt-4o-mini)
#   Gemini:  LLM_PROVIDER=openai, LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, LLM_MODEL=gemini-3.8-flash
#   Groq:    LLM_PROVIDER=openai, LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=openai
# Dán key Gemini (Google AI Studio) vào dòng dưới
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# ---------- Máy chủ AI tự điều khiển (mặc định tắt) ----------
AUTO_CONTROL_ENABLED=false     # firmware ESP32 đã tự chạy AUTO — chỉ bật nếu ESP KHÔNG tự điều khiển
DRY_RUN=false               # true = chạy thử: không ghi Firebase, không gửi Zalo
MIN_TOGGLE_SEC=30           # tối thiểu giữa 2 lần đảo trạng thái 1 thiết bị
PUMP_MAX_ON_MIN=15          # bơm chạy liên tục tối đa (phút) rồi ngắt bảo vệ
MIST_MAX_ON_MIN=20          # phun sương chạy liên tục tối đa (phút)
WATER_LOCKOUT_MIN=10        # thời gian nghỉ bắt buộc sau khi ngắt bảo vệ
HYST_SOIL=3                 # vùng trễ: bơm tắt khi ẩm đất >= ngưỡng + 3
HYST_HUMIDITY=3
HYST_TEMP=1
HYST_LIGHT_RATIO=0.1

# ---------- Thông báo ----------
NOTIFY_DEVICE_CHANGES=true  # báo Zalo MỌI lần ESP32 tự bật/tắt thiết bị (kèm lý do)
NOTIFY_MANUAL_CHANGES=true  # báo Zalo MỌI lần có người bật/tắt từ web
DEVICE_BATCH_SEC=60         # các lần bật/tắt trong 60 giây gom thành 1 tin (đỡ tốn hạn mức Zalo)
ALERT_REPEAT_MIN=30         # nhắc lại cảnh báo chưa xử lý sau N phút
DAILY_REPORT_HOUR=7         # gửi báo cáo 24h lúc 7h sáng (-1 để tắt)
PERIODIC_REPORT_SEC=3600     # gửi tình trạng + thời tiết + Random Forest qua Zalo mỗi giờ (0 = tắt, tối thiểu 600)
HISTORY_RETENTION_DAYS=30

# ---------- Thời tiết ngoài trời (Open-Meteo, miễn phí) cho phân tích Random Forest ----------
# Để trống = TP. Vĩnh Long. Muốn đúng vị trí nhà nấm: điền tọa độ (Google Maps: nhấn giữ -> chép số)
WEATHER_LAT=
WEATHER_LON=
WEATHER_NAME=

# ---------- Google Sheet: ESP32 ghi 1 phút/lần (24/7) -> máy chủ lấy về lấp dữ liệu lúc máy tính tắt ----------
# Mã Sheet = phần giữa /d/ và /edit trong link; Sheet chia sẻ "Bất kỳ ai có đường liên kết - Người xem".
# Xem docs/GOOGLE_SHEET.md. Để trống = không dùng.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=0
